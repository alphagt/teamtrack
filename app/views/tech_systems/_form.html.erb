<%= simple_form_for(@system) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name, :autofocus => true, :required => true %>
	<%= f.input :description %>
	<%= f.input :qos_group, label: get_cfield_name("ts_cust_1") %>
	<%= f.hidden_field :account_id, :value => current_user.primary_account_id %>
    <%= f.association :owner, :as => :select, :collection => User.for_account(current_user.primary_account_id).managers_only, 
    	:label_method => :name, :required => true %>
  </div>
  <br/>
  <div class="form-actions">
  	<div style="float:left">
    	<%= f.button :submit %>
  	</div>
<% end %>
