<h2>Edit <%= resource_name.to_s.humanize %></h2>

<% content_for :nav do %>
	<%  render partial: "layouts/navigation", locals: {active: "account"} %>
<% end %>

<% content_for :main1 do %>



	<%= simple_form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, :class => 'form-vertical' }) do |f| %>
	  <%= f.error_notification %>
	  <%= f.input :name, :autofocus => true %>
	  <%= f.input :email, :required => true %>
	  <%= f.input :password, :autocomplete => "off", :hint => "leave it blank if you don't want to change it", :required => false %>
	  <%= f.input :password_confirmation, :required => false %>
	  <%= f.input :current_password, :hint => "we need your current password to confirm your changes", :required => true %>
	  <%= f.button :submit, 'Update', :class => 'btn-primary' %>
	<% end %>
<% end %>

<% content_for :sidebar do %>
	<table class="table">
		<% if current_user.admin %>
			<tr>
			<td class="danger" ><%= link_to "Cancel my account", registration_path(resource_name), :data => { :confirm => "Are you sure?" }, :method => :delete %></td>
		<% end %>
		<tr>
			<td class="danger" ><%= link_to "Back", :back %> </td>
		<% if current_user.account_list.present? && current_user.account_list.split(',').length > 1 %>
		<tr>
		<td class="danger">
			<label for="acct_list">Tennant:</label>
			<%= select_tag "acct_list", options_for_select(org_mgrs_list(), @mgr_id.to_s) %>
		</td>
	<% end %>
	</table>
<% end %>
