wb = xlsx_package.workbook

wb.add_worksheet(name: "Assignments Wk " + @wk.to_s) do |sheet|

	sheet.add_row ["fiscal Yr", "Fiscal Wk", "Manager", "TeamTrack Org", "Org Owner", "Employee", "Employee Type", 
		"Weeks Effort", "Project", "PRP Theme", "Route To Market", "Stakeholder Org", "Sub-Priority",
		"Allocation Type", "Accounting_Treatment", "Launch Date"]
		
	#get orgs and their owners
	hOrgOwners = orgs_hash()
	puts hOrgOwners	
	@assignments.each do |a|
		iname = "NA"
		ishort = "NA"
		ctp = "NA"
		pPsh = "NA"
		pCat = "NA"
		pRtm = "NA"
		
		p = a.project
		if !p.nil? then
			if a.project.initiative.present? then
				iname = a.project.initiative.name
				if a.project.initiative.tag.present? then ishort = a.project.initiative.tag end
			end
			if a.project.keyproj.present? && a.project.keyproj
				ctp = ishort + "-*" + a.project.name
			else
				ctp = ishort + "-" + (a.project.ctpriority || "NA")	
			end 
			pName = p.name
			pRtm = p.rtm || "Undefined"
			pPsh = p.psh || "Undefined"
			pCat = p.category || "Undefined"
			if !p.fin_type.nil? && !Setting.for_account(p.account_id).find_by_key('fin_type').nil?
				s = Setting.for_account(p.account_id).for_key('fin_type').where('value = ?', p.fin_type)
				if s.length > 0
					pFin = s.first.displayname || "Undefined"
				end
			else
				pFin = p.fin_type
			end
			pEdate = if p.end_date then p.end_date.strftime("%m/%d/%Y") else "In Progress" end
		else
			puts "ASSERT - Missing Project on assignment ?", a.id.to_s
			pName = "NA Project-" + a.id.to_s
		end
		orgOwner = hOrgOwners[a.user.org]
		
		sheet.add_row [a.fiscal_year, a.week_number, a.user.manager.name, a.user.org, orgOwner, a.user.name, a.user.etype, a.effort,
			pName, iname, pRtm, pPsh, 
			ctp, pCat, pFin, pEdate ]
	end

end