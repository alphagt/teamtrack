
<% content_for :main1 do %>
	<h2>Sign up</h2>
	<%= simple_form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => {:class => 'form-vertical' }) do |f| %>
	  <%= f.error_notification %>
	  <%= f.input :name, :autofocus => true, :required => true %> 
	  <%= f.input :email, :required => true %>
	  <%= f.input :password, :required => true %>
	  <%= f.input :password_confirmation, :required => true %>
	  <%= f.hidden_field :primary_account_id, :value => @acct %>
	  <%= f.hidden_field :manager_id, :value => Account.find(@acct).primary_admin_id %>
	  <% if User.for_account(@aid).is_verified.count < Account.find(@act).userquota %>
	  	<%= f.hidden_field :ismanager, :value => true %>
	  	<%= f.hidden_field :verified, :value => true %>
	  <% end %>
	  </br>
	  <%= "My Team: " + if @acct > -0 then Account.find(@acct).name else "NA" end %>
	  </br>
	  </br>
	  <%= f.button :submit, 'Sign up', :class => 'btn-primary' %>
	<% end %>
	<%= render "devise/shared/links" %>
<% end %>