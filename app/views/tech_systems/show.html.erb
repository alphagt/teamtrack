<% content_for :nav do %>
	<%  render partial: "layouts/navigation", locals: {active: "systems"} %>
<% end %>


<% content_for :sidebar do %>
	<table class="table">
	<% if current_user.admin %>
		<tr>
			<td class="danger"><%= link_to 'Edit', edit_tech_system_path(@system) %></td> 
	<% end %>
	<tr>
		<td class="danger"><%= link_to 'Back', tech_systems_path %></td>
	</table>
<% end %> 

<% content_for :main1 do %>
<div class="row">
	<div class="col-md-10 col-centered">
		<div class="col-md-3">
			<br/>
			<p><b>Name: </b><%= @system.name %></p>
			<p><b><%= display_name_for('sys_names', 'service') + ' Group:' %></b><%= @system.qos_group %></p>
			<p><b>Description: </b><%= @system.description %></p>
			<p><b>Owner: </b><%= @system.owner.name %></p>
		</div>
		<div class="col-md-7">
			<%= column_chart @cdataH , adapter: "highcharts", colors: ["#3DB1FF","#0061D7","#FF148A","#FF8A14"], 
				title: 'Effort History',
			    library: { 
						  } %>
		</div>
	</div>
</div>
</br>
<div class="row">
	<div class="col-md-10 col-centered">
		<div class="col-md-3">
		</div>
		<div class="col-md-7">
			<%= pie_chart @sdataH, adapter: "highcharts", colors: ["#3DB1FF","#0061D7","#FF148A","#FF8A14"], 
				title: 'Current Project Effort',
			    library: { plotOptions: {
								pie: {
								  dataLabels: {
									enabled: false,
									style: {
										fontSize: 10},
									format: '<b>{point.name}</b>:<br>{point.percentage:.1f}%',
								   },
								   showInLegend:true
								}
							  }
						  } %>
		</div>
	</div>
</div>	
<% end %>
