<% content_for :nav do %>
	<%  render partial: "layouts/navigation", locals: {active: "tennants"} %>
<% end %>

<% content_for :sidebar do %>
	<table class="table">
		<tr>
		<td class="danger"><%= link_to 'Edit Account', edit_account_path(@account) %></td>
		<tr>
		<% if current_user.superadmin? then %>
			<td class="danger"><%= link_to 'Back', accounts_path() %></td>
		<% else %>
			<td class="danger"><%= link_to 'Back', account_path(@account) %></td>
		<% end %>
	</table>
<% end %>

<% content_for :main1 do %>
<div class="row">
	<div class="col-md-12 col-centered">
		<p>
		  <strong>Name:</strong>
		  <%= @account.name %>
		</p>

		<p>
		  <strong>Admin Email Address:</strong>
		  <%= @account.email %>
		</p>

		<p>
		  <strong>Primary admin:</strong>
		  <%= @account.primary_admin.name %>
		</p>

		<p>
		  <strong>Secondary admin:</strong>
		  <% if @account.secondary_admin then %>
		  	<%= @account.secondary_admin.name %>
		  <% else %>
		  	UnAssigned
		  <% end %>
		</p>

		<p>
		  <strong>Active:</strong>
		  <%= @account.active %>
		</p>

		<p>
		  <strong>Termdate:</strong>
		  <%= @account.termdate %>
		</p>

		<p>
		  <strong>Userquota:</strong>
		  <%= @account.userquota %>
		</p>
	</div>
</div>
<%end%>

