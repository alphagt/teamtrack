<h1>Listing Themes</h1>

<% content_for :nav do %>
	<%  render partial: "layouts/navigation", locals: {active: "initiatives"} %>
<% end %>

<% content_for :sidebarwide do %>
<table class="table">
	<% if current_user.admin %>
		<tr>
		<td class="danger"><%= link_to 'New-' + display_name_for('sys_names', 'initiative'), new_initiative_path %></td>
		<tr>
		<td class="danger"><%= link_to 'Show-All', initiatives_path(:fy => "all") %></td>
	<% end %>
	<tr>
	<td class="danger">
		<label for="f_year">Fiscal Year:</label>
		<%= select_tag "f_year", options_for_select(fy_list(), @fy.to_s) %>
	</td>
	<tr>
	<td class="danger">
		<label for="f_quarter">Quarter:</label>
		<%= select_tag "f_quarter", options_for_select(['All','1','2','3','4'], if !@q.nil? then @q.to_s end) %>
	</td>
</table>

<h5><%= "Average Weekly HC: " + if @fy == current_fy then (@sumEffort/current_week()).round.to_s else 
									""
								end %></h5>
<h5><%= "Period Effort(wks): " + if @fy == current_fy then (@qtdEffort).round.to_s else "" end %></h5>
<% end %>

<% content_for :main1 do %>
<div class="row">
	<div class="col-md-12 col-centered">
		<h5><b><%= @summary + current_user.org %></b></h5>
	</div>
</div>
<div class="row">
  <div class="col-md-12 col-centered">
	<div class="col-md-6">
		<%= image_tag(Gchart.pie(:title => 'Current Effort', 
		:legend => @clabels, :data => @wvals, :size => '450x300', :chart_background => 'CCCCCC',
		:slice_colors => "3DB1FF,0061D7,FF148A,FF8A14", :pieSliceText => 'value'))%>
		</br>
		<p><%= if @showVals then 'Data:  ' + @cdata.to_s end %></p>
	</div>
	<div class="col-md-6">
		<%= image_tag(Gchart.pie(:title => 'YTD Effort', 
		:legend => @clabels, :data => @cvals, :size => '450x300', :chart_background => 'CCCCCC',
		:slice_colors => "3DB1FF,0061D7,FF148A,FF8A14", :pieSliceText => 'value'))%>
		</br>
		<p><%= if @showVals then 'Data:  ' + @cdata.to_s end %></p>
	</div>
  </div>
</div>
<br>
<div class="row">
	<div class="col-md-12 col-centered">
	<% if !@initiatives.nil? then %>
		<div class="row">
			<div class="col-md-12">
			<table class="table">
			  <thead>
			  <tr>
			  	<th></th>
				<th class="col-sm-1">Code</th>
				<th class="col-sm-3">Name</th>
				<th class="col-sm-3">Description</th>
				<th>Fiscal Year</th>
				<th>Current Week Effort</th>
				<th><%= if @fy == current_fy.to_s || @q.to_i > 0 then "QTD Person Weeks" else "FY Person Weeks" end %></th>
				<th>Effective HC</th>
				<% if current_user.admin %>
					<th>Status</th>
				<% end %>
			  </tr>  
			  </thead>
			  <tbody>
			<% @initiatives.where(:active => true).each do |initiative|  %>
			  <%= tag("tr", class: ['warning', 'collapsed'], data: {toggle: 'collapse', target: ".group" + initiative.id.to_s}) %>
				<td class="icon-class"></td>
				<td><%= initiative.tag %></td>
				<td class="link"><u><b><%= link_to initiative.name, initiative %></b></u></td>
				<td><%= initiative.description %></td>
				<td><%= initiative.fiscal %></td>
				<td><%= initiative.current_effort_weeks(current_period) %></td>
				<td><%= if @fy == current_fy && @q.to_i == 0 then initiative.current_effort_weeks(current_period(),true) else
							if @fy == current_fy then initiative.current_effort_weeks(@fy + (@q.to_i * 12).fdiv(100).round(3),true)	else						
					    		if !@fy.is_a? Numeric then initiative.total_effort_weeks(52,initiative.fiscal) else
					    			if @q.to_i == 0  then initiative.total_effort_weeks(52,@fy) else
					    				initiative.current_effort_weeks(@fy + (@q.to_i * 12).fdiv(100).round(3),true)
					    			end 
					    		end 
					    	end
					    end %></td>
				<td><%= if @fy == current_fy && @q.to_i == 0 then (initiative.total_effort_weeks(current_week())/current_week()).round() else
							if @fy == current_fy then (initiative.current_effort_weeks(@fy + (@q.to_i * 12).fdiv(100).round(3),true)/12).round(1) else
				           		if !@fy.is_a? Numeric  then (initiative.total_effort_weeks(52,initiative.fiscal)/52).round(1) else
								 	if @q.to_i == 0 then (initiative.total_effort_weeks(52,@fy)/52).round(1) else
										(initiative.current_effort_weeks(@fy + (@q.to_i * 12).fdiv(100).round(3),true)/12).round(1) 
								 	end
								end
				           	end
				        end %></td>
				<% if current_user.admin %>
					<td><%= if initiative.active then "Active" else "Closed" end %></td>
				<% end %>
			  </tr> 
			  <% @plist = initiative.projects.map{|p| [current_allocation(p,1),p]}.sort_by {|alloc,p| [alloc,p]}.reverse %>
			  <% @plist.each do |a, p| %>
			  	<% if p.keyproj %>
			  		<tr>
			  	<% else %>
			  		<%= tag("tr", class: ['collapse', 'group' + initiative.id.to_s]) %>			
			  	<% end %>
			  		<td></td>
			  		<td></td>
			  		<td class="link" style="text-align: right"><u><%= link_to p.name, p %></u></td>
			  		<td><%= p.description %></td>
			  		<td></td>
			  		<td><%= current_allocation(p,1) %></td>
			  		<td><%= if @fy == current_fy then ytd_allocation(p,true,false,@fy) else
			  					if !@fy.is_a? Numeric then ytd_allocation(p,true,true,initiative.fiscal) else
			  			   			ytd_allocation(p,true,true,@fy)
			  			   		end 
			  			   end %></td>
			  		<td></td>
			  		<% if current_user.admin %>
						<td><%= if p.active then "Active" else "Closed" end %></td>
					<% end %>
			  	</tr>
			  <% end %> 
			<% end %>
	
			</tbody>
			</table>
			</div>
		</div>
	<% else "NO " + display_name_for('sys_names', 'initiative').pluralize() + " DEFINED YET" %>
	<% end %>
	</div>
</div>
<% end %>	
