wb = xlsx_package.workbook

wb.add_worksheet(name: "Assignments Summary ") do |sheet|

	sheet.add_row ["Project", "Initiative", "Manager", "TeamView Org", "Org Owner", "Employee", "Employee Type", 
		"Weeks Effort", "Accounting_Treatment", "Project Launch Date"]
		
	#get orgs and their owners
	hOrgOwners = orgs_hash()
	puts hOrgOwners	
	@assignments.each do |a|
		iname = "NA"
		ishort = "NA"
		p = Project.find_by_id(a[0][0])
		u = User.find_by_id(a[0][1])
		if !p.nil? 
			if p.initiative.present? then
				iname = p.initiative.name
				if p.initiative.tag.present? then ishort = p.initiative.tag end
			end
			orgOwner = hOrgOwners[u.org]
			pEnd = if p.end_date then p.end_date.strftime("%m/%d/%Y") else "In Progress" end
			if !p.fin_type.nil? && !Setting.for_account(p.account_id).find_by_key('fin_type').nil?
				s = Setting.for_account(p.account_id).for_key('fin_type').where('value = ?', p.fin_type)
				if s.length > 0
					pFin = s.first.displayname || "Undefined"
				end
			else
				pFin = p.fin_type
			end
			sheet.add_row [p.name, iname, p.owner.name, u.org, orgOwner, u.name, u.etype, a[1], pFin, 
			pEnd]
		end
	end

end